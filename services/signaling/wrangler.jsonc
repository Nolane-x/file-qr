{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "file-qr-signaling",
  "main": "src/index.js",
  "compatibility_date": "2026-09-06",
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "SessionRoom" }
    ]
  },
  "exports": {
    "SessionRoom": { "type": "durable-object", "storage": "sqlite" }
  },
  "ratelimits": [
    {
      "name": "SESSION_ALLOCATION_RATE_LIMIT",
      "namespace_id": "47046001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "TURN_CREDENTIAL_RATE_LIMIT",
      "namespace_id": "47046002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "vars": {
    "SESSION_TTL_MS": "600000",
    "TURN_CREDENTIAL_TTL_SECONDS": "3600"
  }
}
