{
  "name": "file-qr",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/native",
    "services/signaling"
  ],
  "scripts": {
    "test": "node --test",
    "build:web": "npm --workspace @file-qr/web run build",
    "build:native-ui": "npm --workspace @file-qr/native run build",
    "check:signaling": "npm --workspace @file-qr/signaling run check",
    "check:web-deploy": "wrangler deploy --dry-run --config apps/web/wrangler.jsonc",
    "verify": "npm test && npm run build:web && npm run build:native-ui && npm run check:signaling && npm run check:web-deploy",
    "nui:setup": "node scripts/setup-nui.mjs"
  },
  "overrides": {
    "undici": "7.29.1",
    "sharp": "0.35.4"
  },
  "engines": { "node": ">=22" }
}
